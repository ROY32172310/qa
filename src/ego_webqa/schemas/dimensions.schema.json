{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ROY32172310/qa/master/src/ego_webqa/schemas/dimensions.schema.json",
  "title": "ego-webqa dimension registry",
  "description": "Closed deterministic-check registry exposed by --list-dimensions.",
  "type": "object",
  "required": ["schema_version", "dimensions"],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "description",
          "detector",
          "default_severity",
          "introduced_in",
          "profile",
          "parameters",
          "deprecated_in"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "detector": {
            "type": "string",
            "minLength": 1
          },
          "default_severity": {
            "enum": ["block", "warn"]
          },
          "introduced_in": {
            "type": "string",
            "minLength": 1
          },
          "profile": {
            "enum": ["baseline", "performance", "accessibility"]
          },
          "parameters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "deprecated_in": {
            "type": ["string", "null"]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
