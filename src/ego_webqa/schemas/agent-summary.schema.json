{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ROY32172310/qa/master/src/ego_webqa/schemas/agent-summary.schema.json",
  "title": "ego-webqa agent summary",
  "description": "Root-cause grouped repair summary for an AI coding agent.",
  "type": "object",
  "required": [
    "schema_version",
    "tool",
    "target",
    "status",
    "failed_items",
    "summary",
    "governance",
    "scope_statement"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "tool": {
      "const": "ego-webqa"
    },
    "target": {
      "type": "string"
    },
    "status": {
      "enum": ["pass", "warn", "fail"]
    },
    "failed_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "dimension_id",
          "dimension_version",
          "detector",
          "default_severity",
          "severity",
          "severity_source",
          "override",
          "selector",
          "selectors",
          "text_snippet",
          "trigger",
          "triggers",
          "problem",
          "problems",
          "suggestion",
          "reproduce",
          "occurrences",
          "evidence",
          "evidence_by_viewport"
        ],
        "properties": {
          "dimension_id": {
            "type": "string",
            "minLength": 1
          },
          "dimension_version": {
            "type": "string",
            "minLength": 1
          },
          "detector": {
            "type": "string"
          },
          "default_severity": {
            "enum": ["block", "warn"]
          },
          "severity": {
            "enum": ["block", "warn"]
          },
          "severity_source": {
            "enum": ["default", "override"]
          },
          "override": {
            "type": "object"
          },
          "selector": {
            "type": "string"
          },
          "selectors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "text_snippet": {
            "type": "string"
          },
          "trigger": {
            "type": "string"
          },
          "triggers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "problem": {
            "type": "string"
          },
          "problems": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "suggestion": {
            "type": "string"
          },
          "reproduce": {
            "type": "string"
          },
          "occurrences": {
            "type": "integer",
            "minimum": 1
          },
          "evidence": {
            "type": "object"
          },
          "evidence_by_viewport": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "additionalProperties": true
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "total_block",
        "total_warn",
        "unique_root_causes",
        "affected_viewports",
        "duration_ms",
        "overridden_dimensions",
        "downgraded_blocks",
        "expired_overrides"
      ],
      "properties": {
        "total_block": {
          "type": "integer",
          "minimum": 0
        },
        "total_warn": {
          "type": "integer",
          "minimum": 0
        },
        "unique_root_causes": {
          "type": "integer",
          "minimum": 0
        },
        "affected_viewports": {
          "type": "integer",
          "minimum": 0
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "overridden_dimensions": {
          "type": "integer",
          "minimum": 0
        },
        "downgraded_blocks": {
          "type": "integer",
          "minimum": 0
        },
        "expired_overrides": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "governance": {
      "type": "object"
    },
    "scope_statement": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
