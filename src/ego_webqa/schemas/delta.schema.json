{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ROY32172310/qa/master/src/ego_webqa/schemas/delta.schema.json",
  "title": "ego-webqa report delta",
  "description": "Stable root-cause comparison between compatible report.json files.",
  "type": "object",
  "required": [
    "schema_version",
    "tool",
    "status",
    "gate",
    "compatibility",
    "baseline",
    "current",
    "summary",
    "changes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "tool": {
      "const": "ego-webqa"
    },
    "status": {
      "enum": ["pass", "fail"]
    },
    "gate": {
      "type": "object",
      "required": ["mode", "failed"],
      "properties": {
        "mode": {
          "enum": ["none", "new"]
        },
        "failed": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "compatibility": {
      "type": "object",
      "required": [
        "target_matches",
        "configuration_matches",
        "runtime_matches",
        "target_change_allowed",
        "configuration_change_allowed"
      ],
      "properties": {
        "target_matches": {
          "type": "boolean"
        },
        "configuration_matches": {
          "type": "boolean"
        },
        "runtime_matches": {
          "type": "boolean"
        },
        "target_change_allowed": {
          "type": "boolean"
        },
        "configuration_change_allowed": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "baseline": {
      "$ref": "#/$defs/reportIdentity"
    },
    "current": {
      "$ref": "#/$defs/reportIdentity"
    },
    "summary": {
      "type": "object",
      "required": [
        "new",
        "persistent",
        "changed",
        "resolved",
        "total_changes",
        "blocking_regressions"
      ],
      "properties": {
        "new": {
          "type": "integer",
          "minimum": 0
        },
        "persistent": {
          "type": "integer",
          "minimum": 0
        },
        "changed": {
          "type": "integer",
          "minimum": 0
        },
        "resolved": {
          "type": "integer",
          "minimum": 0
        },
        "total_changes": {
          "type": "integer",
          "minimum": 0
        },
        "blocking_regressions": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fingerprint",
          "dimension_id",
          "dimension_version_after",
          "dimension_version_before",
          "change_type",
          "block_count_before",
          "block_count_after",
          "warning_count_before",
          "warning_count_after",
          "occurrences_before",
          "occurrences_after",
          "viewports_before",
          "viewports_after",
          "selectors",
          "problem",
          "gate_failed"
        ],
        "properties": {
          "fingerprint": {
            "type": "string",
            "minLength": 1
          },
          "dimension_id": {
            "type": "string",
            "minLength": 1
          },
          "dimension_version_after": {
            "type": "string"
          },
          "dimension_version_before": {
            "type": "string"
          },
          "change_type": {
            "enum": ["new", "persistent", "changed", "resolved"]
          },
          "block_count_before": {
            "type": "integer",
            "minimum": 0
          },
          "block_count_after": {
            "type": "integer",
            "minimum": 0
          },
          "warning_count_before": {
            "type": "integer",
            "minimum": 0
          },
          "warning_count_after": {
            "type": "integer",
            "minimum": 0
          },
          "occurrences_before": {
            "type": "integer",
            "minimum": 0
          },
          "occurrences_after": {
            "type": "integer",
            "minimum": 0
          },
          "viewports_before": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "viewports_after": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "selectors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "problem": {
            "type": "string"
          },
          "gate_failed": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "reportIdentity": {
      "type": "object",
      "required": ["target_kind", "status", "counts", "duration_ms", "runtime"],
      "properties": {
        "target_kind": {
          "enum": ["target", "directory"]
        },
        "status": {
          "type": "string"
        },
        "counts": {
          "type": "object"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "runtime": {
          "type": "object"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
